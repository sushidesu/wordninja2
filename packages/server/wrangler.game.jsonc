// 公開する Worker。エンドユーザーが触れるのはここだけ。
{
  "name": "wordninja",
  "main": "src/game-worker.ts",
  "compatibility_date": "2026-06-27",
  // 既定の *.workers.dev を出さず、カスタムドメインだけで公開する。
  // preview_urls は既定で workers_dev を継承するのでこれも無効になる。
  "workers_dev": false,
  "routes": [
    {
      "pattern": "wordninja.dayo.app",
      "custom_domain": true,
    },
  ],
  // クライアントのバンドル(public/client.js)を配る。
  "assets": {
    "directory": "./public",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomDO",
      },
    ],
  },
  // exports は旧来の migrations 配列を置き換えるもの。両方あると設定が拒否される。
  "exports": {
    "RoomDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  // 採用済みお題を読むためだけに使う。書き込みはしない。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordninja",
      "database_id": "14a37558-b551-4f6b-9d49-5706f5cd1182",
      "migrations_dir": "drizzle",
    },
  ],
}
