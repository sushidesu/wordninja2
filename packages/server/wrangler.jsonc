{
  "name": "wordninja-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-27",
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomDO",
      },
    ],
  },
  // exports は旧来の migrations 配列を置き換えるもの。両方あると設定が拒否される。
  "exports": {
    "RoomDO": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordninja-server",
      "database_id": "local",
      "migrations_dir": "drizzle",
    },
  ],
}
