// お題工房の Worker。叩くのは人と LLM だけなので公開しない(deploy しない)。
// リモート D1 に対して使うときは wrangler dev --remote で動かす。
{
  "name": "wordninja-workshop",
  "main": "src/workshop-worker.ts",
  "compatibility_date": "2026-06-27",
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordninja",
      "database_id": "14a37558-b551-4f6b-9d49-5706f5cd1182",
      "migrations_dir": "drizzle",
    },
  ],
}
