{
  "name": "@wordninja/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute wordninja-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute wordninja-db --local --file=./seed.sql",
    "db:migrate:remote": "wrangler d1 execute wordninja-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute wordninja-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "@wordninja/shared": "workspace:^",
    "hono": "^4.12.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260412.1",
    "typescript": "~5.9.2",
    "wrangler": "^4.81.1"
  }
}
