{
  "name": "@wordninja/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/game/client/app.tsx --bundle --minify --format=esm --charset=utf8 --jsx=automatic --jsx-import-source=hono/jsx/dom --outfile=public/game/client.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply wordninja-server --local",
    "db:migrate:remote": "wrangler d1 migrations apply wordninja-server --remote",
    "db:studio": "drizzle-kit studio",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@wordninja/rules": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260627.1",
    "@libsql/client": "^0.17.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.135.0"
  }
}
